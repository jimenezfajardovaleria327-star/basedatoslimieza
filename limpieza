def split_multi_values(valor):
    if valor is None:
        return []
    v = str(valor).strip()
    if v == "" or v.lower() in ["nan", "none"]:
        return []
    valores = [p.strip() for p in v.split(",")]
    valores = [p for p in valores if p not in ["", "nan", "none", "None"]]
    return valores

