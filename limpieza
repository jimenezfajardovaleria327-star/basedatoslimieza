# 6) 1FN: separar nombre y apellido del propietario
# -----------------------------------------------------------
def es_empresa(x):
    x = str(x).strip()
    if x == "":
        return True
    xup = x.upper()
    if any(k in xup for k in ["S.A.", "SA", "S DE RL", "LTDA", "SOCIEDAD", "INDUSTRIAL", "COMERCIAL", "SERVICIOS", "GROUP", "CORP"]):
        return True
    partes = x.split()
    if len(partes) >= 3:
        return True
    return False

def separar_nombre_apellido(x):
    x = str(x).strip()
    if x == "":
        return "", ""
    if es_empresa(x):
        return x, ""
    partes = x.split()
    if len(partes) >= 2:
        return partes[0], " ".join(partes[1:])
    return x, ""

